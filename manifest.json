{
  "manifest_version": 3,
  "name": "范围随机定时刷新",
  "version": "1.5",
  "description": "区间随机刷新+图标倒计时+完美停止",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "refresh.png",
      "48": "refresh.png",
      "128": "refresh.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "refresh.png"
  }
}
